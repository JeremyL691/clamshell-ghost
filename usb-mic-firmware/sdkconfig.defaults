CONFIG_IDF_TARGET="esp32s3"

# Flash & PSRAM (Waveshare ESP32-S3-Touch-AMOLED-1.75C)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU Frequency & Power Management
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# USB Device UAC (Mac Dedicated Pure Microphone)
CONFIG_UAC_TUSB_VID=0x303A
CONFIG_UAC_TUSB_PID=0x8001
CONFIG_UAC_TUSB_MANUFACTURER="Waveshare"
CONFIG_UAC_TUSB_PRODUCT="ESP32-S3 Dual Microphone"
CONFIG_UAC_TUSB_SERIAL_NUM="WS175CMIC01"
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SUPPORT_MACOS=y
CONFIG_UAC_TINYUSB_TASK_CORE=0
CONFIG_UAC_MIC_TASK_CORE=1
CONFIG_UAC_TINYUSB_TASK_PRIORITY=6
CONFIG_UAC_MIC_TASK_PRIORITY=6

# Keep UART0 for log (do not conflict with USB OTG on GPIO19/20)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
